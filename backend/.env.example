# ════════════════════════════════════════════════════════════════════
# Campus Digest — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it's in .gitignore already.
# ════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────
DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

# ── Supabase ─────────────────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Google OAuth + APIs ───────────────────────────────────────────────
# console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-YOUR_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ── Telegram ─────────────────────────────────────────────────────────
# Bot token: from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCDefghijklmnopqrstuvwxyz

# User API credentials: from my.telegram.org → App Configuration
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# Your college Telegram group numeric ID
# (forward a group message to @userinfobot to find the group ID)
TELEGRAM_GROUP_ID=-1001234567890

# ── Firebase FCM ──────────────────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate key
# Download the JSON file and put its PATH here
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ── Upstash Redis ─────────────────────────────────────────────────────
# upstash.com → Your database → REST API
UPSTASH_REDIS_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_TOKEN=AX8eASQgYour_Token_Here

# ── Scheduler Settings ────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=5
DIGEST_HOUR=9
DIGEST_MINUTE=0
MISSED_ALERT_HOURS=4
